@model List<Regen.Models.CreditPackage>

@{
    ViewData["Title"] = "Pricing";

    // Use the cheapest price per credit as the baseline.
    var basePricePerCredit = Model
        .Where(p => p.Credits > 0)
        .Select(p => p.Amount / p.Credits)
        .DefaultIfEmpty(0m)
        .FirstOrDefault();

    // Calculate the maximum available discount.
    var maxDiscount = Model
        .Where(p => p.Credits > 0)
        .Select(p =>
        {
            var regularPrice = p.Credits * basePricePerCredit;

            return regularPrice > 0
                ? (1m - p.Amount / regularPrice) * 100m
                : 0m;
        })
        .DefaultIfEmpty(0m)
        .Max();
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-pricing.css" />
    <link rel="stylesheet" href="~/custom/css/pricing.css" />
}

@section PageScripts {
    <script src="~/js/pages-pricing.js"></script>
}

<div class="pricing-page">
    <div class="container py-12">

        <!-- Header -->
        <div class="text-center mb-10">

            <span class="badge bg-label-primary rounded-pill px-3 py-2 mb-3">
                SIMPLE & TRANSPARENT PRICING
            </span>

            <h2 class="fw-bold mb-3">
                Get more out of Regen
            </h2>

            <p class="text-body-secondary mx-auto pricing-subtitle">
                Choose a credit package that works for you.
                One-time payment, no subscriptions, no hidden fees.
            </p>

            @if (maxDiscount > 0)
            {
                <div class="mt-4">
                    <span class="badge bg-label-success rounded-pill px-3 py-2">
                        <i class="ri ri-price-tag-3-line me-1"></i>
                        Save up to @maxDiscount.ToString("0")% with larger packages!
                    </span>
                </div>
            }

        </div>

        <!-- Pricing Cards -->
        <div class="row justify-content-center g-4">

            @foreach (var package in Model)
            {
                var isPopular = package.Name.Equals(
                    "Pro",
                    StringComparison.OrdinalIgnoreCase
                );

                var regularPrice = package.Credits * basePricePerCredit;

                var discount = regularPrice > 0
                    ? (1m - package.Amount / regularPrice) * 100m
                    : 0m;

                var hasDiscount = discount > 0;

                <div class="col-12 col-md-6 col-xl-3">

                    <div class="card pricing-card h-100 @(isPopular ? "pricing-popular" : "")">

                        @if (isPopular)
                        {
                            <div class="popular-badge">
                                MOST POPULAR
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-5">

                            <!-- Discount Badge -->
                            @if (hasDiscount)
                            {
                                <div class="discount-badge">
                                    <i class="ri ri-price-tag-3-line me-1"></i>
                                    SAVE @discount.ToString("0")%
                                </div>
                            }
                            else
                            {
                                <div class="discount-placeholder"></div>
                            }

                            <!-- Icon -->
                            <div class="pricing-icon mb-4">
                                <i class="ri ri-coins-line"></i>
                            </div>

                            <!-- Package Name -->
                            <h4 class="fw-bold mb-2">
                                @package.Name
                            </h4>

                            <p class="text-body-secondary mb-4">
                                @package.Credits.ToString("N0") credits
                            </p>

                            <!-- Price -->
                            <div class="pricing-price mb-2">

                                <span class="currency">
                                    @package.Currency
                                </span>

                                <span class="amount">
                                    @package.Amount.ToString("N2")
                                </span>

                            </div>

                            <!-- Original Price -->
                            @if (hasDiscount)
                            {
                                <div class="original-price mb-3">
                                    <span>
                                        @package.Currency @regularPrice.ToString("N2")
                                    </span>

                                    <span class="text-success ms-1">
                                        You save @package.Currency
                                        @((regularPrice - package.Amount).ToString("N2"))
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="original-price mb-3">
                                    &nbsp;
                                </div>
                            }

                            <div class="pricing-divider mb-4"></div>

                            <!-- Features -->
                            <ul class="pricing-features list-unstyled mb-5">

                                <li>
                                    <i class="ri ri-check-line"></i>
                                    @package.Credits.ToString("N0") credits
                                </li>

                                <li>
                                    <i class="ri ri-check-line"></i>
                                    One-time payment
                                </li>

                                <li>
                                    <i class="ri ri-check-line"></i>
                                    Instant credit allocation
                                </li>

                                <li>
                                    <i class="ri ri-check-line"></i>
                                    No recurring charges
                                </li>

                            </ul>

                            <!-- Purchase Button -->
                            <div class="mt-auto">

                                <button type="button"
                                        class="btn @(isPopular ? "btn-primary" : "btn-outline-primary") w-100 py-3"
                                        onclick="purchasePackage(@package.Id)">

                                    Get @package.Name

                                    <i class="ri ri-arrow-right-line ms-1"></i>
                                </button>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="text-center mt-8">

            <p class="text-body-secondary mb-0">
                <i class="ri ri-shield-check-line me-1"></i>
                Secure payments powered by Stripe.
                Buy credits whenever you need them.
            </p>

        </div>
    </div>
</div>
