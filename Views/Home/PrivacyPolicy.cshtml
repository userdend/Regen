@{
    ViewData["Title"] = "Privacy Policy";
}

@section PageStyles {
    <style>
        .privacy-policy-card {
            margin: 0 auto;
        }

        .privacy-policy-header {
            background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), 0.12), rgba(var(--bs-info-rgb), 0.08));
            border-bottom: 1px solid var(--bs-border-color);
        }

        .privacy-policy-content {
            color: var(--bs-body-color);
            font-size: 1rem;
            line-height: 1.75;
        }

        .privacy-policy-content h2 {
            color: var(--bs-heading-color);
            font-size: 1.15rem;
            font-weight: 600;
            margin: 2rem 0 0.75rem;
        }

        .privacy-policy-content h2:first-child {
            margin-top: 0;
        }

        .privacy-policy-content p {
            margin-bottom: 1rem;
        }

        .privacy-policy-content ul {
            margin-bottom: 1rem;
            padding-left: 1.5rem;
        }

        .privacy-policy-content li {
            margin-bottom: 0.35rem;
            padding-left: 0.25rem;
        }

        .privacy-policy-contact {
            background-color: var(--bs-tertiary-bg);
            border-left: 3px solid var(--bs-primary);
        }

        .privacy-policy-contact p:last-child {
            margin-bottom: 0;
        }

        @@media (max-width: 575.98px) {

            .privacy-policy-header,
            .privacy-policy-content {
                padding: 1.25rem !important;
            }
        }
    </style>
}

<div class="row g-6 justify-content-center">
    <div class="col-12 col-xl-10 col-xxl-9">
        <article class="card privacy-policy-card overflow-hidden">
            <header class="privacy-policy-header card-body p-6">
                <div class="d-flex align-items-start gap-3">
                    <div class="avatar avatar-md flex-shrink-0">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="icon-base ri ri-shield-check-line icon-24px"></i>
                        </span>
                    </div>
                    <div>
                        <h1 class="mb-2">Privacy Policy</h1>
                        <div class="d-flex flex-wrap gap-2 text-body-secondary">
                            <span><strong>Effective Date:</strong> November 19, 2026</span>
                            <span><strong>Last Updated:</strong> November 19, 2026</span>
                        </div>
                    </div>
                </div>
            </header>

            <div class="privacy-policy-content card-body p-6">
                <p>Welcome to <strong>Regen</strong> ("we", "us", or "our"). We respect your privacy and are committed
                    to
                    protecting your personal information.</p>

                    <p>This Privacy Policy explains how we collect, use, store, and protect information when you access or
                        use our platform.</p>

                        <h2>1. Information We Collect</h2>
                        <p>We aim to minimize the collection of personal information.</p>

                        <p>The primary personal information we collect and retain for account identification is your
                            <strong>email address</strong>, which is obtained when you sign in using Google authentication.
                        </p>

                        <p>We do not request or store your Google account password.</p>

                        <p>Our platform may also temporarily process technical information, form URLs, submitted content, and
                            usage information necessary to provide our services.</p>

                            <h2>2. How We Use Your Information</h2>
                            <p>We use your email address and necessary account information to:</p>
                            <ul>
                                <li>Identify and authenticate your account.</li>
                                <li>Associate your account with purchased credits and service usage.</li>
                                <li>Provide customer support.</li>
                                <li>Communicate important service-related updates.</li>
                                <li>Prevent unauthorized access, fraud, and abuse.</li>
                            </ul>
                            <p>We do not sell your personal information to advertisers or data brokers.</p>

                            <h2>3. Google Authentication</h2>
                            <p>Our platform uses Google authentication to simplify account access.</p>

                            <p>When you sign in, Google may provide basic account information according to the permissions you
                                authorize.</p>

                                <p>We do not have access to your Google password.</p>

                                <p>Your use of Google's authentication services is also subject to Google's applicable privacy policies.
                                </p>

                                <h2>4. Data Storage and Security</h2>
                                <p>We implement reasonable technical and organizational measures to protect information against
                                    unauthorized access, disclosure, modification, or loss.</p>

                                    <p>However, no online service or data storage system can guarantee absolute security.</p>

                                    <p>We encourage users to protect their Google accounts and avoid sharing sensitive information through
                                        our platform.</p>

                                        <h2>5. Data Retention and Account Removal</h2>
                                        <p>We retain your email address for as long as necessary to maintain your account and provide our services.</p>

                                        <p>You may request the removal of your email address and associated account information by contacting our support team.</p>

                                        <div class="privacy-policy-contact rounded p-4 mb-4">
                                            <p><strong>Support Email:</strong> boydbayndend99@gmail.com</p>
                                            <p>Upon receiving a verified removal request, we will process it within a reasonable period, subject to applicable legal, security, and recordkeeping obligations.</p>
                                        </div>

                                        <p>Removing your account may result in the loss of access to unused credits, scheduled activities, and account-related services.</p>

                                        <h2>6. Third-Party Services</h2>
                                        <p>Our platform may use third-party services for authentication, payment processing, hosting, and
                                            technical operations.</p>

                                            <p>These providers may process information necessary to perform their services under their respective
                                                privacy policies.</p>

                                                <p>We do not intentionally share your email address with third parties for independent advertising
                                                    purposes.</p>

                                                    <h2>7. Children's Privacy</h2>
                                                    <p>Our services are not intended for children under the age of 18.</p>

                                                    <p>We do not knowingly collect personal information from children under 18. If we become aware that such
                                                        information has been collected, we will take reasonable steps to remove it.</p>

                                                        <h2>8. Changes to This Privacy Policy</h2>
                                                        <p>We may update this Privacy Policy periodically to reflect changes in our services, operations, or
                                                            applicable legal requirements.</p>

                                                            <p>Any updates will be published on this page with a revised effective date.</p>

                                                            <p>Continued use of the platform after changes take effect constitutes acknowledgment of the updated
                                                                policy.</p>

                                                                <h2>9. Contact Us</h2>
                                                                <p>If you have questions about this Privacy Policy, your personal information, or account removal,
                                                                    please contact:</p>

                                                                    <div class="privacy-policy-contact rounded p-4">
                                                                        <p><strong>Email:</strong> boydbayndend99@gmail.com</p>
                                                                        <p><strong>Platform:</strong> Regen</p>
                                                                    </div>
                                                                </div>
                                                            </article>
                                                        </div>
                                                    </div>
