@{
    ViewData["Title"] = "Terms of Service";
}

@section PageStyles {
    <style>
        .terms-service-card {
            margin: 0 auto;
        }

        .terms-service-header {
            background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), 0.12), rgba(var(--bs-info-rgb), 0.08));
            border-bottom: 1px solid var(--bs-border-color);
        }

        .terms-service-content {
            color: var(--bs-body-color);
            font-size: 1rem;
            line-height: 1.75;
        }

        .terms-service-content h2 {
            color: var(--bs-heading-color);
            font-size: 1.15rem;
            font-weight: 600;
            margin: 2rem 0 0.75rem;
        }

        .terms-service-content h2:first-child {
            margin-top: 0;
        }

        .terms-service-content p {
            margin-bottom: 1rem;
        }

        .terms-service-content ul {
            margin-bottom: 1rem;
            padding-left: 1.5rem;
        }

        .terms-service-content li {
            margin-bottom: 0.35rem;
            padding-left: 0.25rem;
        }

        .terms-service-callout {
            background-color: var(--bs-tertiary-bg);
            border-left: 3px solid var(--bs-primary);
        }

        .terms-service-callout p:last-child {
            margin-bottom: 0;
        }

        @@media (max-width: 575.98px) {

            .terms-service-header,
            .terms-service-content {
                padding: 1.25rem !important;
            }
        }
    </style>
}

